$maxovsize=200;   ## filter instances by maximum overlap size
$seqlength=100000; ## crop sequences to this length (use something
		     ## large to use full sequences)

## parameters of rrikin_enum/barriers
$max_hyb_length_diff = 7;
$region              = 0; ## if region_factor is defined then the region is computed!
$region_factor       = 1.2; ## region=overlap*region_factor 
$span                = 200;


$datadir=$ENV{HOME}."/Research/Projects/RRIkinetics/YeastAntisense";

$pairtab_filename="$datadir/SI_Tab4.txt";
$seqtab_filename="$datadir/SI_Tab2.txt";
$sequences_filename="$datadir/SI_Tab2-seqs.fa"; ## simple fasta of sequences

## whether to skip certain stages, if files exist
$skip_enum=1; ## whether to skip state enumeration
$skip_barriers=1; ## whether to skip basin constructions (barriers) 
$skip_pruning=1; ## whether to skip pruning
$skip_kin=1;  ## whether to skip kinetics calculation by call to xrates
$skip_pdf=1;  ## whether to skip call to R and pdf generation

$RRIKDIR=$ENV{HOME}."/Research/Projects/RRIkinetics/RRIKin";
$outdir="/scr/k61san/will/RRIKin/Results/results";

$ENUM_OPTS="--max-hyb-energy 7 --max-total-energy 12";
$MIN_RATE=5e-12;
$NUM_OUT=1500;
$NUM_PEQU=10000;
$QU_PEQU=50;
$QU_OUT=8;

$num_threads=48;
