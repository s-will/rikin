#!/usr/bin/env perl

=head1 run_all

run_all

=head1 SYNOPSIS

run_all [options]

=head1 DESCRIPTION

Run kinetics calculations for pairs in table SI_Tab4.txt subject to
filter criteria (see constants in code.)

=head1 OPTIONS

=over 8

=item  B<--help>

Brief help message

=item  B<--man>                         

Full documentation

=item B<--dry>

Dry run. Test only.

=item  B<-q, --quiet>

Quiet

=item  B<-v, --verbose>

Verbose

=back

=cut


use strict;
use warnings;

use FindBin;
use lib $FindBin::Bin;

use RRIkin;


##------------------------------------------------------------
## constants


my $maxovsize=160;   ## filter instances by maximum overlap size
my $seqlength=100000; ## crop sequences to this length (use something
		     ## large to use full sequences)

## parameters of rrikin_enum/barriers
my $max_hyb_length_diff = 7;
my $region              = 180;
my $span                = 200;


my $datadir=$ENV{HOME}."/Research/Projects/RRIkinetics/YeastAntisense";

my $pairtab_filename="$datadir/SI_Tab4.txt";
my $seqtab_filename="$datadir/SI_Tab2.txt";
my $sequences_filename="$datadir/SI_Tab2-seqs.fa"; ## simple fasta of sequences

## whether to skip certain stages, if files exist
my $skip_enum=1; ## whether to skip state enumeration
my $skip_barriers=1; ## whether to skip basin constructions (barriers) 
my $skip_pruning=0; ## whether to skip pruning
my $skip_kin=0;  ## whether to skip kinetics calculation by call to xrates
my $skip_pdf=0;  ## whether to skip call to R and pdf generation

my $RRIKDIR=$ENV{HOME}."/Research/Projects/RRIkinetics/RRIKin";
my $outdir="/scr/k61san/will/RRIKin/Results/results";


my $COMMON_OPTS=
    "--max-hyb-length-diff $max_hyb_length_diff "
    ."--regionA -$region --regionB $region "
    ."--span $span ";
  ##  --max-hyb-length 50 (use only with state recovery!)

my $ENUM_OPTS="--max-hyb-energy 7 --max-total-energy 12";
my $MIN_RATE=5e-12;
my $NUM_OUT=2000;
my $NUM_PEQU=8000;
my $QU_PEQU=40;
my $QU_OUT=10;

my $num_threads=48;
my $dry=0;

##----------------------------------------
## subs
sub min($$) {
    my ($x,$y)=@_;
    return ($x<=$y)?$x:$y;
}
sub max($$) {
    my ($x,$y)=@_;
    return ($x>=$y)?$x:$y;
}

sub writecmd($$$) {
    my ($fh,$cmd,$active)=@_;
    
    if (!$active) {
	print $fh "# ";
    }
    print $fh $cmd;
}

##------------------------------------------------------------
## options

use Getopt::Long;
use Pod::Usage;

my $help;
my $man;
my $quiet;
my $verbose;


GetOptions(
    "dry" => \$dry,
    "verbose" => \$verbose,
    "quiet" => \$quiet,   
    "help"=> \$help,
    "man" => \$man
    ) || pod2usage(2);

pod2usage(1) if $help;
pod2usage(-exitstatus => 0, -verbose => 2) if $man;


## ------------------------------------------------------------
## main part

my %sequences; ## hash of sequences by name

## read sequences (simple fasta format)
open(IN,$sequences_filename) || die "Cannot read input file $sequences_filename.\n";
while(<IN>) {
    if (/^>\s*(.*)/) {
	$sequences{$1}=<IN>;
    }
}
close IN;

mkdir "$outdir" unless $dry;
print "mkdir \"$outdir\"\n" if $dry;

system "cp $0 $outdir" unless $dry;

my $logfile="$outdir/README";
my $logfh;
$logfh=*STDOUT if $dry;
open($logfh,">>$logfile") unless $dry;

print $logfh "run_all: RRIkinetics calculations for RNA antisense pairs .\n";
print $logfh "START ".readpipe("date")."\n";
print $logfh "Saved copy of script 'run_all' in $outdir.\n";

close $logfh unless $dry;

## read pairs table
my $pairtab=read_table("$pairtab_filename");

## read sequence table
my $seqtab=read_table("$seqtab_filename");

my $joblistfh;
if (!$dry) {
    open($joblistfh,">$outdir/joblist") || die "Cannot open job file $outdir/joblist for output.";
} else {
    $joblistfh=*STDOUT;
}

my @jobs=();

## iterate over pairtab
for my $row (@$pairtab) {
    my $name1=$row->{"seg1.id"};
    my $name2=$row->{"seg2.id"};

    my $jobname="$name1-$name2";

    my $seqrow1 = lookup_table($seqtab,"tx_ID",$name1);
    my $seqrow2 = lookup_table($seqtab,"tx_ID",$name2);

    my $overlap = $seqrow1->{"last"} - $seqrow2->{"first"};
    
    my $cor = sprintf "%0.2f", $row->{"cor"};

    ## filter instances
    next if ($overlap > $maxovsize); 
    
    my $header = "$name1 $name2 $cor; ";
    #print "\t".$sequences{$name1}."\n";
    #print "\t".$sequences{$name2}."\n";
    
    $header.= "pos1: ".$seqrow1->{"first"}."-".$seqrow1->{"last"}.
	" ".$seqrow1->{"strand"}.
	"; pos2: ".$seqrow2->{"first"}."-".$seqrow2->{"last"}.
	" ".$seqrow2->{"strand"}."; ";

    $header.= "len1=".($seqrow1->{"last"} - $seqrow1->{"first"}).
	   "; len2=".($seqrow2->{"last"} - $seqrow2->{"first"}).
	   "; overlap=".$overlap.
	   "\n";

    my $seqA;
    my $seqB;

    # distinguish cases: "left" sequence on + strand and "right" on - strand, or vice versa.
    if ($seqrow1->{"strand"} eq "+") {
	$seqA=$sequences{$name1};
	$seqA=substr($seqA,-min(length($seqA),$seqlength));
	$seqB=$sequences{$name2};
	$seqB=substr($seqB,-min(length($seqB),$seqlength));
	chomp $seqA;
	chomp $seqB;
	$seqB=reverse $seqB;
    } else {
	$seqA=$sequences{$name1};
	$seqA=substr($seqA,0,min(length($seqA),$seqlength));
	$seqB=$sequences{$name2};
	$seqB=substr($seqB,0,min(length($seqB),$seqlength));
	chomp $seqA;
	chomp $seqB;
	$seqA=reverse $seqA;
    }

    my $rc_seqB=rev_compl($seqB);

    #print $sequences{$name1};
    #print $sequences{$name2};
    

    $header.= $seqA."\n";
    $header.= (" "x(length($seqA)-$overlap)).$seqB."\n";
    #print $rc_seqB."\n";
    
    print $header if ($verbose && !$dry);

    my $outfn="$outdir/$jobname";
    
    my $jobfh;
    if (!$dry) {
	open($jobfh,">$outfn.job") || die "Cannot open job file $outfn.job for output."; 
    } else {
	$jobfh=*STDOUT;
	
	print "\n-------------------------------------------------- file: $outfn.job\n";
    }

    my $comment_header;
    ($comment_header = $header) =~ s/\n/\n## /g;

    print $jobfh "## $comment_header\n\n";
    
    print $jobfh "echo '==================== $name1 $name2 ====================' \n\n";

    print $jobfh "seqA=$seqA\n\n";
    print $jobfh "seqB=$seqB\n\n";

    my $active;

    $active=!($skip_enum && (-e "$outfn.senum.gz" || -e "$outfn.senum"));
    writecmd $jobfh,"$RRIKDIR/src/rrikin_enum \$seqA \$seqB --no-double ".
	"--verbose $ENUM_OPTS $COMMON_OPTS > $outfn.enum\n\n",$active;
    writecmd $jobfh,"sort -g -k1 $outfn.enum > $outfn.senum\n",$active;
    writecmd $jobfh,"rm $outfn.enum\n\n",$active;

    $active=(!$skip_barriers || (! -e "$outfn.bar.gz" && ! -e "$outfn.bar"));
    writecmd $jobfh,"gunzip $outfn.senum.gz\n",$active;
    writecmd $jobfh,"$RRIKDIR/src/rrikin_barriers \$seqA \$seqB -i $outfn.senum ".
	"-o $outfn.bar --track $outfn.bartrack --no-double ".
	"--verbose $COMMON_OPTS\n\n",$active;
    writecmd $jobfh,"gzip $outfn.senum\n",$active;
    writecmd $jobfh,"gzip $outfn.bartrack\n\n",$active;

    $active=(!$skip_pruning || (! -e "$outfn.pf"));
    writecmd $jobfh,"gunzip $outfn.bar.gz\n",$active;
    writecmd $jobfh,"$RRIKDIR/src/rrikin_prune $outfn.bar --pffile $outfn.pf  --min-rate $MIN_RATE --num-out $NUM_OUT --num-pequ $NUM_PEQU --qu-out $QU_OUT --qu-pequ $QU_PEQU --track $outfn.prunetrack --verbose --barfile $outfn.bar_prune --ratesfile $outfn.rates > $outfn.out\n\n",$active;
    writecmd $jobfh,"gzip $outfn.bar\n",$active;
    writecmd $jobfh,"gzip $outfn.prunetrack\n\n",$active;

    $active=(!$skip_kin || (! -e "$outfn.kin"));
    writecmd $jobfh,"$RRIKDIR/src/xrates.m $outfn.pf --out $outfn.kin --t8 1e16\n\n",$active;
    
    $active=(!$skip_pdf || (! -e "$outfn.pdf"));
    writecmd $jobfh,"Rscript $RRIKDIR/src/kinetics.R $outfn.kin $outfn.pdf 'cor=$cor; ol=$overlap'\n",$active;
    
    close $jobfh unless $dry;
    print "-------------------------------------------------- eof\n\n" 
	if $dry;
    
    print "Write to joblist: " if ($dry);

    print $joblistfh "$outfn.job\n";
    
    system("chmod +x $outfn.job") unless $dry;
    
    push @jobs,"$outfn.job"; 
}

print "\nGenerated ".int(@jobs)." jobs.\n" unless $quiet;

my $cmd="parallel -j $num_threads < $outdir/joblist";
$cmd.=" | gzip -c >> $outdir/protocol.gz  2>&1";

open($logfh,">>$logfile") unless $dry;
print $logfh "\nCALL: $cmd\n";
close $logfh unless $dry;

if (!$dry) { 
    close $joblistfh;
    system("chmod +x $outdir/joblist");
    
    system $cmd;
}

open($logfh,">>$logfile") unless $dry;
print $logfh "FINISHED ".readpipe("date")."\n";
close $logfh unless $dry;


## ------------------------------------------------------------
