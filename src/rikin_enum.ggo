purpose "Calculate kinetics of RNA-RNA-interaction"


usage "_enum [options] seq1 seq2"

description "Enumerates states of RNA-RNA-interaction in the RRI hybrid ensemble model. \
States are modelled as equilibrated partitions of the whole interaction ensemble. \
Supports states with single and double hybridization sites."

args "-F rikin_enum_cmdline -u"

option "max-hyb-energy" - "Threshold for single hybridization site energy" double default="1e12" optional

option "max-total-energy" - "Threshold for single hybridization site energy" double default="1e12" optional

option "max-hyb-length" - "Maximum length of each subsequence in hybridization site" int default="-1" optional

option "max-hyb-length-diff" - "Maximum difference of lengths in hybridization sites" int default="-1" optional

option "double-sites" - "Include double hybridization site configurations" optional

option "add-open-state" - "Add the open state (without interaction)" optional

option "binary" - "Binary encoding of states in output" optional

option "homodimer" - "Enumerate conformations of homodimer (only one sequence accepted)" optional
option "antisense" - "Enumerate conformations of sense/antisense pair (only one sequence accepted)" optional

option "regionA" - "Restrict region for interaction <n> bases at 5' head (>0) or 3' tail (<0) of sequence A; use i-j for region (0=no restriction)." string default="0" optional

option "regionB" - "Restrict region for interaction <n> bases at 5' head (>0) or 3' tail (<0) of sequence B; use i-j for region (0=no restriction)." string default="0" optional

option "span" - "Base pair span for local folding. Set this to turn on local folding." int default="-1" optional

option "temperature" - "Folding temperature" double default="37.0" optional

option "verbose" - "Turn on verbose output" optional

text "\nInput sequences:\n"
text "  seq1 first sequence in 5'->3' orientation\n"
text "  seq2 second sequence in 5'->3' orientation"
