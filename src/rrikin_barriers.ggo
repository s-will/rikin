purpose "Calculate kinetics of RNA-RNA-interaction"

usage "_barriers [options] seq1 seq2"

description "Reads energy-sorted list of states of RNA-RNA-interaction in the RRI hybrid ensemble model \
and combines them into basin macrostates. Furthermore, computes rates between macro-states.\
States are modelled as equilibrated partitions of the whole interaction ensemble."

args "-F rrikin_barriers_cmdline -u"

option "max-outflow" - "Maximal outflow of a basin; otherwise merge" double default="1e6" optional
option "min-rate" - "Minimum transition rate; otherwise ignore" double default="0" optional
option "min-p-equ" - "Minimum equilibrium probability of a basin; otherwise merge" double default="0" optional

option "barfile" - "Write treekin compatible barrier file" string optional
option "ratesfile" - "Write rates matrix to a treekin compatible file" string optional

option "no-double-sites" - "Don't consider double hybridization sites" optional

option "dont-simplify-graph" - "Turn of all barrier graph simplifications" optional

option "binary" - "Assume binary encoding of states in input" optional

option "verbose" - "Turn on verbose output" optional
option "debug" - "Turn on debugging output" optional


text "\nInput sequences:\n"
text "  seq1 first sequence in forward orientation\n"
text "  seq2 second sequence in reverse(!) orientation"
