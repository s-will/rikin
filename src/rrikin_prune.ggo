purpose "Prune state system for kinetics of RNA-RNA interaction"

usage "_prune [options] bgfile"

description "Prune barrier graph by various criteria (outflow, rate, and equilibrium probability)."

args "-F rrikin_prune_cmdline -u"

option "max-outflow" - "Maximal outflow of a state; otherwise dissolve" double default="1e6" optional
option "min-pequ" - "Minimum equilibrium probability of a state; otherwise dissolve" double default="0" optional

option "qu-outflow" -
        "State quantile (in percent) to keep due to max-outflow criterion (approximate)" 
       double optional

option "qu-pequ"    - "State quantile (in percent) to keep due to min-pequ criterion" double optional

option "num-outflow" - 
       "Number of states to keep due to max-outflow criterion (approximate)" 
       double optional

option "num-pequ"    - "Number of states to keep due to min-pequ criterion" double optional

option "min-rate" - "Minimum transition rate; otherwise ignore (sparsifies edges)" double default="0" optional

option "dont-simplify-graph" - "Turn of all barrier graph simplifications" optional

option "no-special-first-state" - "Treat first state like any other state; def=never dissolve first state" optional

option "barfile" - "Write treekin compatible pseudo-barrier file" string optional
option "ratesfile" - "Write rates matrix to a treekin compatible file" string optional

option "pffile" - "Write partition functions of states and transition states" string optional

option "rxns" - "Write reactions to file in 'rxns' format (Stochastirator-compatible)" string optional
option "spcs" - "Write species to file in 'spcs' format (Stochastirator-compatible)" string optional
option "nameA" - "Specify name of molecule A in rxns/spcs (def=A)" string optional
option "nameB" - "Specify name of molecule B in rxns/spcs (def=B, in case of homodimer, defaults to nameA)" string optional
option "nameAB" - "Specify name of molecule AB in rxns/spcs (def=nameA+nameB)" string optional

option "to-keep" - "Keep only the specified states (separate indices by comma)" int optional multiple

option "verbose" - "Turn on verbose output" optional
option "debug" - "Turn on debugging output" optional

option "compress-track" - "Gzip-compress all written track or pp track information" optional

option "track" - "Turn on tracking of pruning, providing output filename" string optional

option "track-pps-out" - "Track interaction pair probabilities (specifies output file)" string optional

option "track-pps-in" - "Track interaction pair probabilities (specifies input file)" string optional

option "pp-min-prob" - "Minimum interaction pair probabilities for output" double default="1e-2" optional


text "\nInput file: bgfile = file as generated by rrikin_barriers -o <filename>\n"

text ""
text "If more than one specification of outflow or pequ is provided, the strictest filter is applied."
